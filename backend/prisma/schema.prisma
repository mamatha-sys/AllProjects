generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support in Prisma, so these are plain strings.
// Valid values, enforced in application code (see backend/src/routes):
// Role: SUPER_ADMIN | ADMIN | MANAGER | ASSISTANT_MANAGER | STL | TL | RECRUITER | BDE | CLIENT
// Priority: HIGH | MEDIUM | LOW
// RequirementStatus: OPEN | CLOSED
// ApplicationStage: NEW | RECRUITER_REVIEW | RECRUITER_APPROVED | WITH_BDE | BDE_APPROVED | SHARED_WITH_CLIENT |
//   CLIENT_REVIEW | CLIENT_SHORTLISTED | INTERVIEW_SCHEDULED | INTERVIEW_COMPLETED | SELECTED | OFFER |
//   OFFER_ACCEPTED | JOINED | HIRED | REJECTED | HOLD
// InterviewStatus: SCHEDULED | COMPLETED | CANCELLED
// AgreementStatus: NOT_SENT | SENT | SIGNED

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          String
  atsDepartment String?
  clientId      String?
  client        Client?  @relation(fields: [clientId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  requirementsAsRecruiter Requirement[]  @relation("RecruiterRequirements")
  requirementsAsBde       Requirement[]  @relation("BdeRequirements")
  auditLogs               AuditLog[]
  notifications           Notification[]
}

model Client {
  id                String    @id @default(cuid())
  name              String
  industry          String?
  location          String?
  // E-sign agreement flow (mirrors the prototype's generateAgreementDocument /
  // sendAgreementToClient / confirmAgreementByClient).
  agreementStatus   String    @default("NOT_SENT") // NOT_SENT | SENT | SIGNED
  agreementDocument String? // generated agreement text/markup
  agreementSentAt   DateTime?
  agreementSignedAt DateTime?
  agreementSignedBy String? // name typed by the client at e-sign time
  createdAt         DateTime  @default(now())

  requirements Requirement[]
  users        User[]
}

model Requirement {
  id          String   @id @default(cuid())
  title       String
  description String?
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  department  String?
  priority    String   @default("MEDIUM")
  status      String   @default("OPEN") // OPEN | CLOSED
  recruiterId String?
  recruiter   User?    @relation("RecruiterRequirements", fields: [recruiterId], references: [id])
  bdeId       String?
  bde         User?    @relation("BdeRequirements", fields: [bdeId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications Application[]
}

model Candidate {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  source    String?  @default("TeamLink Website")
  skills    String? // comma-separated, used for matching-candidates suggestions
  createdAt DateTime @default(now())

  applications Application[]
}

model Application {
  id              String    @id @default(cuid())
  candidateId     String
  candidate       Candidate @relation(fields: [candidateId], references: [id])
  requirementId   String
  requirement     Requirement @relation(fields: [requirementId], references: [id])
  stage           String    @default("NEW")
  interviewStatus String?
  interviewAt     DateTime?
  joiningDate     DateTime? // set when the client confirms joining
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([candidateId, requirementId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  fromValue String?
  toValue   String?
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  title     String
  message   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
