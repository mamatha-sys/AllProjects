generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support in Prisma, so these are plain strings.
// Valid values, enforced in application code (see backend/src/routes):
// Role: SUPER_ADMIN | ADMIN | MANAGER | ASSISTANT_MANAGER | STL | TL | RECRUITER | BDE | CLIENT | ACCOUNTANT | EMPLOYEE
// Priority: HIGH | MEDIUM | LOW
// RequirementStatus: OPEN | CLOSED
// ApplicationStage: NEW | RECRUITER_REVIEW | RECRUITER_APPROVED | WITH_BDE | BDE_APPROVED | SHARED_WITH_CLIENT |
//   CLIENT_REVIEW | CLIENT_SHORTLISTED | INTERVIEW_SCHEDULED | INTERVIEW_COMPLETED | SELECTED | OFFER |
//   OFFER_ACCEPTED | JOINED | HIRED | REJECTED | HOLD
// InterviewStatus: SCHEDULED | COMPLETED | CANCELLED

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  role           String
  atsDepartment  String?
  clientId       String?
  client         Client?  @relation(fields: [clientId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  requirementsAsRecruiter Requirement[] @relation("RecruiterRequirements")
  requirementsAsBde       Requirement[] @relation("BdeRequirements")
  auditLogs               AuditLog[]
  employee                Employee?
}

model Client {
  id        String   @id @default(cuid())
  name      String
  industry  String?
  location  String?
  createdAt DateTime @default(now())

  requirements Requirement[]
  users        User[]
  invoices     Invoice[]
}

model Requirement {
  id            String             @id @default(cuid())
  title         String
  description   String?
  clientId      String
  client        Client             @relation(fields: [clientId], references: [id])
  department    String?
  priority      String             @default("MEDIUM")
  status        String             @default("OPEN")
  recruiterId   String?
  recruiter     User?              @relation("RecruiterRequirements", fields: [recruiterId], references: [id])
  bdeId         String?
  bde           User?              @relation("BdeRequirements", fields: [bdeId], references: [id])
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  applications Application[]
  invoices     Invoice[]
}

model Candidate {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  source    String?  @default("TeamLink Website")
  createdAt DateTime @default(now())

  applications Application[]
  invoices     Invoice[]
}

model Application {
  id            String            @id @default(cuid())
  candidateId   String
  candidate     Candidate         @relation(fields: [candidateId], references: [id])
  requirementId String
  requirement   Requirement       @relation(fields: [requirementId], references: [id])
  stage         String            @default("NEW")
  interviewStatus   String?
  interviewAt       DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([candidateId, requirementId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  fromValue String?
  toValue   String?
  createdAt DateTime @default(now())
}

// =============================================================================
// HRMS
// =============================================================================

model Employee {
  id                String   @id @default(cuid())
  userId            String?  @unique
  user              User?    @relation(fields: [userId], references: [id])
  employeeCode      String   @unique
  name              String
  email             String?
  phone             String?
  department        String?
  designation       String?
  location          String?
  dateOfJoining     DateTime?
  employmentStatus  String   @default("Active") // Active | Notice Period | Exit Process | Relieved
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  attendance    Attendance[]
  leaveRequests LeaveRequest[]
  payslips      Payslip[]
}

model Attendance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  date       String   // YYYY-MM-DD
  status     String   // Present | Absent | Late | Half Day | Leave
  checkIn    String?
  checkOut   String?
  createdAt  DateTime @default(now())

  @@unique([employeeId, date])
}

model LeaveRequest {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  type       String   // Sick | Casual | Earned | Unpaid
  fromDate   String
  toDate     String
  reason     String?
  status     String   @default("Pending") // Pending | Approved | Rejected | Cancelled
  createdAt  DateTime @default(now())
  decidedAt  DateTime?
}

model Payslip {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  month      String   // YYYY-MM
  basic      Float
  hra        Float
  allowances Float
  deductions Float
  netPay     Float
  generatedAt DateTime @default(now())

  @@unique([employeeId, month])
}

// =============================================================================
// ACCOUNTS
// =============================================================================

model Invoice {
  id              String    @id @default(cuid())
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id])
  candidateId     String?
  candidate       Candidate? @relation(fields: [candidateId], references: [id])
  requirementId   String?
  requirement     Requirement? @relation(fields: [requirementId], references: [id])
  amount          Float
  gst             Float     @default(0)
  tds             Float     @default(0)
  status          String    @default("Pending") // Pending | Paid | Overdue
  invoiceDate     String
  dueDate         String?
  paymentTerms    String?   @default("Net 30")
  createdAt       DateTime  @default(now())
}

model BankTransaction {
  id               String   @id @default(cuid())
  date             String
  description      String
  type             String   // Credit | Debit
  amount           Float
  matched          Boolean  @default(false)
  matchedInvoiceId String?
  createdAt        DateTime @default(now())
}
