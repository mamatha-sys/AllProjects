generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support in Prisma, so these are plain strings.
// Valid values, enforced in application code (see backend/src/routes):
// Role: SUPER_ADMIN | ADMIN | MANAGER | ASSISTANT_MANAGER | STL | TL | RECRUITER | BDE | CLIENT | ACCOUNTANT | EMPLOYEE
// Priority: HIGH | MEDIUM | LOW
// RequirementStatus: OPEN | CLOSED
// ApplicationStage: NEW | AI_INTERVIEW_REQUIRED | AI_INTERVIEW_SCHEDULED | AI_INTERVIEW_COMPLETED |
//   RECRUITER_REVIEW | RECRUITER_APPROVED | WITH_BDE | BDE_APPROVED | SHARED_WITH_CLIENT |
//   CLIENT_REVIEW | CLIENT_SHORTLISTED | INTERVIEW_SCHEDULED | INTERVIEW_COMPLETED | SELECTED | OFFER |
//   OFFER_ACCEPTED | JOINED | HIRED | REJECTED | HOLD
// InterviewStatus: SCHEDULED | COMPLETED | CANCELLED

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  role           String
  atsDepartment  String?
  clientId       String?
  client         Client?  @relation(fields: [clientId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  requirementsAsRecruiter Requirement[] @relation("RecruiterRequirements")
  requirementsAsBde       Requirement[] @relation("BdeRequirements")
  auditLogs               AuditLog[]
  employee                Employee?
  notifications           Notification[]
}

model Client {
  id        String   @id @default(cuid())
  name      String
  industry  String?
  location  String?
  createdAt DateTime @default(now())

  requirements Requirement[]
  users        User[]
  invoices     Invoice[]
}

model Requirement {
  id            String             @id @default(cuid())
  title         String
  description   String?
  clientId      String
  client        Client             @relation(fields: [clientId], references: [id])
  department    String?
  priority      String             @default("MEDIUM")
  status        String             @default("OPEN")
  recruiterId   String?
  recruiter     User?              @relation("RecruiterRequirements", fields: [recruiterId], references: [id])
  bdeId         String?
  bde           User?              @relation("BdeRequirements", fields: [bdeId], references: [id])
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  applications Application[]
  invoices     Invoice[]
}

model Candidate {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  source    String?  @default("TeamLink Website")
  createdAt DateTime @default(now())

  applications Application[]
  invoices     Invoice[]
}

model Application {
  id            String            @id @default(cuid())
  candidateId   String
  candidate     Candidate         @relation(fields: [candidateId], references: [id])
  requirementId String
  requirement   Requirement       @relation(fields: [requirementId], references: [id])
  stage         String            @default("NEW")
  interviewStatus   String?
  interviewAt       DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([candidateId, requirementId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  fromValue String?
  toValue   String?
  createdAt DateTime @default(now())
}

// =============================================================================
// HRMS
// =============================================================================

// Super Admin-managed lists that populate the Department/Team dropdowns
// elsewhere in the app (e.g. adding an employee). Employee.department/team
// stay plain strings (matching the name here) rather than foreign keys, so
// existing employee records never break if a department is later renamed.
model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  teams Team[]
}

model Team {
  id           String     @id @default(cuid())
  name         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([departmentId, name])
}

model Employee {
  id                String   @id @default(cuid())
  userId            String?  @unique
  user              User?    @relation(fields: [userId], references: [id])
  employeeCode      String   @unique
  name              String
  email             String?
  phone             String?
  department        String?
  team              String?
  designation       String?
  location          String?
  dateOfJoining     DateTime?
  employmentStatus  String   @default("Active") // Active | On Probation | Notice Period | Exit Process | Relieved | Exited
  employeeType      String?  @default("Full-time") // Full-time | Contract | Intern
  dateOfBirth       DateTime?
  gender            String?
  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyContactRelation String?
  address           String?
  addressType       String?  // Current | Permanent
  addressLine1      String?
  addressLine2      String?
  city              String?
  district          String?
  state             String?
  country           String?
  postalCode        String?
  bloodGroup        String?
  branch            String?  // office location: Bengaluru | Chennai | Hyderabad, etc.
  shift             String?  @default("General (9:00 AM – 6:00 PM)")
  employmentExperience String? @default("Fresher") // Fresher | Experienced
  educationDetails  String?
  skills            String?
  bankName          String?
  bankAccountNumber String?
  ifscCode          String?
  panNumber         String?
  aadhaarNumber     String?
  uanNumber         String?
  pfNumber          String?
  esiNumber         String?
  onboardingTasks   String?  // JSON array of {task, completed}
  offboardingStatus String?  // null | Serving Notice | Cleared
  offboardingTasks  String?  // JSON array of {task, completed}
  pendingChanges    String?  // JSON array of {field, from, to} awaiting HR approval
  profileStage      String   @default("Assigned") // Assigned | Pending Review | Locked
  isLocked          Boolean  @default(false) // once HR approves the filled-in profile, the employee can no longer self-edit
  unlockRequestReason String? // reason selected when requesting edit access on a locked profile
  unlockRequestStatus String? // null | Pending | Approved | Rejected
  unlockRequestCount  Int     @default(0) // lifetime count, capped (see UNLOCK_REQUEST_LIMIT)
  reportingManagerId String?
  reportingManager    Employee?  @relation("ManagerReports", fields: [reportingManagerId], references: [id])
  directReports       Employee[] @relation("ManagerReports")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  attendance             Attendance[]
  attendanceRegularizations AttendanceRegularization[]
  leaveRequests          LeaveRequest[]
  payslips               Payslip[]
  records                EmployeeRecord[]
  performanceReviews     PerformanceReview[]
  courseAssignments      CourseAssignment[]
  projectAssignments     ProjectAssignment[]
  surveyResponses        SurveyResponse[]
  acknowledgments        Acknowledgment[]
  salaryStructure        SalaryStructure?
  fnfRequests            FnfRequest[]
}

// Generic table backing the smaller, similarly-shaped HRMS self-service areas
// (one Prisma model instead of ~11 near-identical ones): KT, Targets,
// Resignation, Recognition, Disciplinary, Shift Roster, Timesheet, Assets,
// Expense Claims, Helpdesk, Access Requests, Weekly Ideas.
model EmployeeRecord {
  id         String   @id @default(cuid())
  type       String   // KT | TARGET | RESIGNATION | RECOGNITION | DISCIPLINARY | SHIFT | TIMESHEET | ASSET | EXPENSE | HELPDESK | ACCESS_REQUEST | WEEKLY_IDEA
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  title      String
  detail     String?
  status     String   @default("Open")
  date       String?  // due date / shift date / timesheet date / expense date, as relevant
  amount     Float?   // expense claim amount
  hours      Float?   // timesheet hours
  category   String?  // helpdesk category / expense category / asset type, as relevant
  priority   String?  // helpdesk priority: Low | Medium | High | Urgent
  progressPct Int?    // 0-100, for targets/goals
  location   String?  // expense claim location / travel destination
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Named shift patterns (e.g. Morning 09:00–18:00) that employees are rostered
// into — Shift & Roster assigns an employee to one of these per date via
// EmployeeRecord(type: 'SHIFT').
model ShiftPattern {
  id        String   @id @default(cuid())
  name      String
  startTime String
  endTime   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Attendance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  date       String   // YYYY-MM-DD
  status     String   // Present | Absent | Late | Half Day | Leave
  checkIn    String?
  checkOut   String?
  createdAt  DateTime @default(now())

  @@unique([employeeId, date])
}

// A request to correct a punch after the fact (missing/incorrect check-in or check-out).
model AttendanceRegularization {
  id               String   @id @default(cuid())
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id])
  date             String
  requestedCheckIn String?
  requestedCheckOut String?
  reason           String?
  status           String   @default("Pending") // Pending | Approved | Rejected
  createdAt        DateTime @default(now())
  decidedAt        DateTime?
}

model LeaveRequest {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  type       String   // Sick | Casual | Earned | Unpaid
  fromDate   String
  toDate     String
  reason     String?
  status     String   @default("Pending") // Pending | Approved | Rejected | Cancelled
  createdAt  DateTime @default(now())
  decidedAt  DateTime?
}

// Configurable leave policy — types, caps, and the reasons offered when approving.
model LeaveType {
  id      String  @id @default(cuid())
  code    String  @unique
  name    String
  cap     Int     @default(0)
  unit    String  @default("yr") // yr | month | unpaid
  carries Boolean @default(false)
  active  Boolean @default(true)
}

model LeaveReason {
  id     String  @id @default(cuid())
  label  String
  active Boolean @default(true)
}

model Holiday {
  id        String   @id @default(cuid())
  name      String
  date      String
  createdAt DateTime @default(now())
}

model Payslip {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  month      String   // YYYY-MM
  basic      Float
  hra        Float
  allowances Float
  deductions Float
  netPay     Float
  // Detailed breakup, mirroring the reference app's payslip components.
  bonus            Float? @default(0)
  specialAllowance Float? @default(0)
  employerPf       Float? @default(0)
  employeePf       Float? @default(0)
  professionalTax  Float? @default(0)
  gratuity         Float? @default(0)
  lopDays          Float? @default(0) // loss-of-pay days deducted this cycle
  generatedAt DateTime @default(now())

  @@unique([employeeId, month])
}

// One employee's pay structure — either a flat Stipend, or a Package broken
// into Basic/HRA/Bonus/Special Allowance with PF/PT deductions and employer
// costs, matching the reference app's CTC breakup.
model SalaryStructure {
  id               String   @id @default(cuid())
  employeeId       String   @unique
  employee         Employee @relation(fields: [employeeId], references: [id])
  payMode          String   @default("Package") // Package | Stipend
  ctc              Float    @default(0)
  stipend          Float    @default(0)
  basic            Float    @default(0)
  hra              Float    @default(0)
  bonus            Float    @default(0)
  specialAllowance Float    @default(0)
  employerPf       Float    @default(0)
  employeePf       Float    @default(0)
  professionalTax  Float    @default(0)
  gratuity         Float    @default(0)
  updatedAt        DateTime @updatedAt
}

// Full & Final settlement request, raised when an employee's offboarding completes.
model FnfRequest {
  id               String   @id @default(cuid())
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id])
  lastWorkingDate  String
  status           String   @default("Pending") // Pending | Processed
  settlementAmount Float?
  createdAt        DateTime @default(now())
  processedAt      DateTime?
}

// =============================================================================
// ACCOUNTS
// =============================================================================

model Invoice {
  id              String    @id @default(cuid())
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id])
  candidateId     String?
  candidate       Candidate? @relation(fields: [candidateId], references: [id])
  requirementId   String?
  requirement     Requirement? @relation(fields: [requirementId], references: [id])
  amount          Float
  gst             Float     @default(0)
  tds             Float     @default(0)
  status          String    @default("Pending") // Pending | Paid | Overdue
  invoiceDate     String
  dueDate         String?
  paymentTerms    String?   @default("Net 30")
  createdAt       DateTime  @default(now())
}

model BankTransaction {
  id               String   @id @default(cuid())
  date             String
  description      String
  type             String   // Credit | Debit
  amount           Float
  matched          Boolean  @default(false)
  matchedInvoiceId String?
  createdAt        DateTime @default(now())
}

model OfficeExpense {
  id            String   @id @default(cuid())
  category      String
  location      String?
  monthlyAmount Float
  createdAt     DateTime @default(now())
}

// =============================================================================
// HRMS — long tail
// =============================================================================

model PerformanceReview {
  id             String   @id @default(cuid())
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id])
  period         String   // e.g. "2026-H1"
  score          Int      // 0-100
  band           String   // High | Medium | Low
  recommendation String   // Recommended | Not Recommended
  notes          String?
  createdAt      DateTime @default(now())
}

model Course {
  id       String   @id @default(cuid())
  title    String
  category String?  // Onboarding | ATS | Compliance | Soft Skills
  duration String?
  createdAt DateTime @default(now())

  assignments CourseAssignment[]
}

model CourseAssignment {
  id         String   @id @default(cuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id])
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  completed  Boolean  @default(false)
  assignedAt DateTime @default(now())

  @@unique([courseId, employeeId])
}

model Project {
  id        String   @id @default(cuid())
  name      String
  status    String   @default("Active") // Active | Completed | On Hold
  createdAt DateTime @default(now())

  assignments ProjectAssignment[]
}

model ProjectAssignment {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  role       String?
  assignedAt DateTime @default(now())

  @@unique([projectId, employeeId])
}

model Survey {
  id        String   @id @default(cuid())
  title     String
  status    String   @default("Active") // Active | Closed
  questions String   // JSON-encoded array of question strings
  createdAt DateTime @default(now())

  responses SurveyResponse[]
}

model SurveyResponse {
  id         String   @id @default(cuid())
  surveyId   String
  survey     Survey   @relation(fields: [surveyId], references: [id])
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  answers    String   // JSON-encoded array of answer strings
  submittedAt DateTime @default(now())

  @@unique([surveyId, employeeId])
}

model PolicyDocument {
  id          String   @id @default(cuid())
  title       String
  category    String?  // Policy | Compliance
  mandatory   Boolean  @default(false)
  published   Boolean  @default(true)
  target      String?  @default("All Employees")
  uploadedBy  String?
  uploadedDate String
  createdAt   DateTime @default(now())

  acknowledgments Acknowledgment[]
}

model Acknowledgment {
  id           String         @id @default(cuid())
  documentId   String
  document     PolicyDocument @relation(fields: [documentId], references: [id])
  employeeId   String
  employee     Employee       @relation(fields: [employeeId], references: [id])
  acknowledgedAt DateTime     @default(now())

  @@unique([documentId, employeeId])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  category  String?  // Holiday | Policy | General | Event
  pinned    Boolean  @default(false)
  target    String?  @default("All Employees")
  postedBy  String?
  date      String
  createdAt DateTime @default(now())
}

model HrConfig {
  id                            String @id @default(cuid())
  freeLateArrivalsPerMonth      Int    @default(2)
  freeEarlyLogoutsPerMonth      Int    @default(1)
  earliestExcusableEarlyLogout  String @default("17:00")
  // Attendance policy
  graceTimeMinutes              Int    @default(15)
  halfDayHours                  Float  @default(4)
  fullDayHours                  Float  @default(8)
  // Payroll policy — how attendance turns into pay
  unmarkedDaysUnpaid            Boolean @default(true)
  weekendsPaid                  Boolean @default(true)
  paidLeaveDaysPerMonth         Int    @default(1)
  // CTC split settings — how every employee's CTC is broken into components.
  // Special Allowance always absorbs whatever's left over so the pieces
  // reconcile exactly back to CTC.
  basicPctOfCtc                 Float  @default(50)
  hraPctOfBasic                 Float  @default(40)
  bonusPctOfBasic               Float  @default(8.33)
  employeePfPctOfBasic          Float  @default(12)
  employerPfPctOfBasic          Float  @default(12)
  employeePfMonthlyCap          Float  @default(1800)
  employerPfMonthlyCap          Float  @default(1800)
  gratuityPctOfBasic            Float  @default(4.81)
  professionalTaxFlat           Float  @default(200)
  // Leave policy — concurrent leave caps
  concurrentLeaveCapPct         Int    @default(30)
  concurrentLeaveCapFlat        Int    @default(2)
  leaveReasonThresholdDays      Int    @default(4)
}

// =============================================================================
// ADMINISTRATION
// =============================================================================

model Company {
  id      String @id @default(cuid())
  name    String
  email   String?
  phone   String?
  address String?
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  title     String
  message   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
